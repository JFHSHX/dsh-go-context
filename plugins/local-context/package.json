{
  "name": "dsh-go-context",
  "version": "0.3.0",
  "description": "Native dsh-go context insights, usage trends and Markdown reports powered by dsh-context",
  "license": "MIT",
  "author": "JFHSHX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFHSHX/dsh-go-context.git",
    "directory": "plugins/local-context"
  },
  "homepage": "https://github.com/JFHSHX/dsh-go-context#readme",
  "bugs": "https://github.com/JFHSHX/dsh-go-context/issues",
  "keywords": ["deepseek-harness", "dsh-go", "dsh-context", "context", "plugin"],
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib/", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-go-context-cost": "0.2.0",
    "dsh-go-context-activity": "0.2.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "上下文洞察",
      "en": "Context"
    },
    "icon": "chart",
    "contributes": {
      "composer.actions": [
        {
          "id": "ctx-open",
          "label": {
            "zh": "上下文",
            "en": "Context"
          },
          "icon": "chart",
          "effect": {
            "type": "open",
            "page": "panel:ctx-panel"
          }
        },
        {
          "id": "ctx-overview-open",
          "label": {
            "zh": "总览",
            "en": "Overview"
          },
          "icon": "history",
          "effect": {
            "type": "open",
            "page": "panel:ctx-overview"
          }
        }
      ],
      "session.actions": [
      { "id": "ctx-report", "label": { "zh": "复制上下文报告", "en": "Copy report" }, "icon": "copy" }
    ],
    "composer.strip": [
        {
          "id": "ctx-strip",
          "icon": "chart",
          "panel": "ctx-panel"
        }
      ],
      "panels": [
        {
          "id": "ctx-panel",
          "title": {
            "zh": "上下文洞察",
            "en": "Context"
          },
          "icon": "chart",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        },
        {
          "id": "ctx-overview",
          "title": {
            "zh": "用量总览",
            "en": "Usage"
          },
          "icon": "history",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        },
        {
          "id": "ctx-trend",
          "title": {
            "zh": "上下文演变",
            "en": "Evolution"
          },
          "icon": "trajectory",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        },
        {
          "id": "ctx-insights",
          "title": {
            "zh": "全部洞察",
            "en": "Insights"
          },
          "icon": "lightbulb",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  }
}
