{
  "name": "dsh-go-context-cost",
  "version": "0.2.0",
  "description": "Native dsh-go spending statistics powered by dsh-context",
  "license": "MIT",
  "author": "JFHSHX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFHSHX/dsh-go-context.git",
    "directory": "plugins/local-context-cost"
  },
  "homepage": "https://github.com/JFHSHX/dsh-go-context#readme",
  "bugs": "https://github.com/JFHSHX/dsh-go-context/issues",
  "keywords": ["deepseek-harness", "dsh-go", "dsh-context", "context", "plugin"],
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib/", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "花费统计",
      "en": "Cost"
    },
    "icon": "wallet",
    "contributes": {
      "composer.actions": [
        {
          "id": "cost-open",
          "label": {
            "zh": "花费",
            "en": "Cost"
          },
          "icon": "wallet",
          "effect": {
            "type": "open",
            "page": "panel:ctxc-cost"
          }
        }
      ],
      "panels": [
        {
          "id": "ctxc-cost",
          "title": {
            "zh": "花费统计",
            "en": "Cost"
          },
          "icon": "wallet",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  }
}
